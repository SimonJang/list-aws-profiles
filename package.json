{
	"name": "list-aws-profiles",
	"version": "0.0.0-semantically-released",
	"description": "List local AWS profiles",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('lib', {recursive: true, force: true})\"",
		"build": "npm run clean && tsc --project tsconfig.json",
		"test": "npm run build && npm run test:runtime && npm run test:types",
		"test:runtime": "node --test test/runtime.test.js",
		"test:types": "tsc --project tsconfig.test.json && node node_modules/typescript-3-7/lib/tsc.js --project tsconfig.legacy.json",
		"prepack": "npm test",
		"deploy": "npm run prepack && npx np"
	},
	"keywords": [
		"AWS",
		"IAM"
	],
	"repository": "https://github.com/SimonJang/list-aws-profiles",
	"author": "Simon Jang",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "22.20.1",
		"types-node-8": "npm:@types/node@8.10.66",
		"typescript": "7.0.2",
		"typescript-3-7": "npm:typescript@3.7.5"
	},
	"files": [
		"lib"
	],
	"engines": {
		"node": ">= 8"
	},
	"dependencies": {},
	"packageManager": "npm@12.0.1"
}
